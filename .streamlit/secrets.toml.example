# Copy to .streamlit/secrets.toml (git-ignored) or set the same names as
# environment variables. On Streamlit Cloud paste these into App settings > Secrets.
# Leave a URL unset to keep that source in DEMO.

# --- Azure OpenAI (used for GPT-4o frame analysis and the Neuro SAN agents) ---
AZURE_API_KEY = ""
AZURE_ENDPOINT = "https://<resource>.openai.azure.com/"
DEPLOYMENT_NAME = "gpt-4o"
API_VERSION = "2024-12-01-preview"

# --- Neuro SAN ---------------------------------------------------------------
# NEURO_SAN_MODE: "direct" (in-process on Azure; default when neuro-san is installed),
#                 "neuro_san" (neuro-san HTTP server) or "json" (your own REST API)
NEURO_SAN_MODE = ""
NEURO_SAN_API_URL = ""            # e.g. "http://localhost:8080"
NEURO_SAN_AGENT_NAME = "phygital_operations_intelligence"
NEURO_SAN_API_KEY = ""

# --- Evidence sources (each returns a JSON list of EvidenceEvent objects) ----
DIGITAL_WORK_API_URL = ""         # Soroco / task-mining export
DIGITAL_WORK_API_KEY = ""
VIDEO_AI_API_URL = ""             # optional own CV endpoint; if empty, Azure GPT-4o vision is used
VIDEO_AI_API_KEY = ""
ERP_API_URL = ""
ERP_API_KEY = ""
IOT_API_URL = ""
IOT_API_KEY = ""

INTEGRATION_TIMEOUT_SECONDS = "120"
